# Пример настроек. Скопируйте этот файл в .env рядом с manage.py и заполните
# своими значениями. Настоящий .env в репозиторий не попадает — он в .gitignore.

# Секретный ключ Django, обязателен. Любая случайная строка, но лучше
# сгенерировать её так:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-замените-на-свой-случайный-ключ

# Отладочный режим: подробные страницы ошибок и раздача статики самим Django.
# На боевом сервере обязательно False.
DEBUG=True

# Домены, с которых разрешено открывать сайт, через запятую.
# Нужны при DEBUG=False.
ALLOWED_HOSTS=127.0.0.1,localhost

# Ключ API Яндекс.Геокодера. Как его получить — написано в README,
# раздел «Как получить ключ Яндекс.Геокодера».
# Без ключа сайт работает, но расстояния до ресторанов не считаются.
YANDEX_GEOCODER_API_KEY=

# База данных. Если не задать, будет SQLite в файле db.sqlite3 рядом с manage.py.
# DATABASE_URL=postgres://user:password@localhost:5432/star_burger
